{
  "info": {
    "_postman_id": "b5df8c3e-56f7-4fbc-bf95-f9a77b365a18",
    "name": "Bolipost - Autenticacion de clientes",
    "description": "Registro e inicio de sesion para sistemas externos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registrar cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Juan Perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"ClaveSegura123\",\n  \"password_confirmation\": \"ClaveSegura123\",\n  \"device_name\": \"Postman\",\n  \"tipodocumentoidentidad\": \"1\",\n  \"numero_carnet\": \"12345678\",\n  \"complemento\": \"1A\",\n  \"razon_social\": \"Juan Perez\",\n  \"telefono\": \"71234567\",\n  \"direccion\": \"Av. Principal 123\"\n}"
        },
        "url": "{{base_url}}/api/clientes/register",
        "description": "Crea el cliente y guarda automaticamente el token en access_token. Cambie el correo si ya ejecuto este ejemplo."
      }
    },
    {
      "name": "2. Iniciar sesion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"ClaveSegura123\",\n  \"device_name\": \"Postman\"\n}"
        },
        "url": "{{base_url}}/api/clientes/login",
        "description": "Valida las credenciales y guarda automaticamente el token en access_token."
      }
    }
  ]
}
